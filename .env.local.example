# Local API profile — copied to repo-root `.env` by `npm run env:local`
# AUTH0_* must match apps/mobile/.env.local (same tenant + audience).
# See docs/runbooks/auth0-and-social-idp-setup.md § Local API + Auth0 sync

JWT_SECRET=replace-with-dev-secret
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
PORT=4000
HOST=0.0.0.0
PERSISTENCE_MODE=postgres
# LOCAL DEV ONLY (docker-compose.local.yml defaults).
DATABASE_URL=postgres://crewcue:crewcue@localhost:5432/crewcue

MAPTILER_API_KEY=
STREAM_API_KEY=
STREAM_API_SECRET=

# Required for mobile Auth0 login against this local API (must match mobile EXPO_PUBLIC_*).
# Issuer = https://{EXPO_PUBLIC_AUTH0_DOMAIN}/
AUTH0_ISSUER=https://dev-xxxxxxx.us.auth0.com/
AUTH0_AUDIENCE=https://api.crewcue.staging
# Optional custom claim namespace if your Auth0 Action uses one:
# AUTH0_CLAIM_NAMESPACE=https://crewcue.app
