# Prefer profile switching: `npm run env:init` then `npm run env:local` / `npm run env:staging`.
# Active file is `.env` (gitignored). Templates: `.env.local.example`, `.env.staging.example`.

JWT_SECRET=replace-with-dev-secret
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
PORT=4000
HOST=0.0.0.0
PERSISTENCE_MODE=postgres
# LOCAL DEV ONLY (docker-compose.local.yml defaults). Never reuse these credentials outside local development.
DATABASE_URL=postgres://crewcue:crewcue@localhost:5432/crewcue

# Auth0 (required for mobile Auth0 login against this API). Must match apps/mobile EXPO_PUBLIC_AUTH0_*.
# AUTH0_ISSUER=https://YOUR_TENANT.us.auth0.com/
# AUTH0_AUDIENCE=https://api.crewcue.staging
