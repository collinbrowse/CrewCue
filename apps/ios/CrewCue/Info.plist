<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDisplayName</key>
  <string>CrewCue</string>
  <key>CrewCueAPIBaseURL</key>
  <string>$(CREWCUE_API_BASE_URL)</string>
  <key>CrewCueAuth0Domain</key>
  <string>$(CREWCUE_AUTH0_DOMAIN)</string>
  <key>CrewCueAuth0ClientId</key>
  <string>$(CREWCUE_AUTH0_CLIENT_ID)</string>
  <key>CrewCueAuth0Audience</key>
  <string>$(CREWCUE_AUTH0_AUDIENCE)</string>
  <key>CrewCueRevenueCatAPIKey</key>
  <string>$(CREWCUE_REVENUECAT_API_KEY)</string>
  <key>CrewCueSentryDSN</key>
  <string>$(CREWCUE_SENTRY_DSN)</string>
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>com.crewcue.ios</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>crewcue</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleURLName</key>
      <string>auth0</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>com.crewcue.ios</string>
      </array>
    </dict>
  </array>
  <!-- Run files shared or opened from watch apps and Files (run-share-import). CrewCue copies the
       file in (no editing in place). FIT and TCX have no system type, so they're declared here. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Run file</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.crewcue.fit</string>
        <string>com.crewcue.tcx</string>
        <string>com.topografix.gpx</string>
        <string>public.zip-archive</string>
      </array>
    </dict>
  </array>
  <key>LSSupportsOpeningDocumentsInPlace</key>
  <false/>
  <key>UTImportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>com.crewcue.fit</string>
      <key>UTTypeDescription</key>
      <string>FIT activity</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>fit</string>
        </array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>com.crewcue.tcx</string>
      <key>UTTypeDescription</key>
      <string>TCX activity</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.xml</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>tcx</string>
        </array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>com.topografix.gpx</string>
      <key>UTTypeDescription</key>
      <string>GPX track</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.xml</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>gpx</string>
        </array>
        <key>public.mime-type</key>
        <array>
          <string>application/gpx+xml</string>
        </array>
      </dict>
    </dict>
  </array>
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>CrewCue shares the runner's position with their crew during the race.</string>
  <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
  <string>Allow "Always" so CrewCue keeps sharing the runner's position with their crew every few minutes while the phone is locked during the race. Tracking runs only after you tap Start tracking, and stops at the finish.</string>
  <key>UIBackgroundModes</key>
  <array>
    <string>location</string>
  </array>
  <key>UILaunchScreen</key>
  <dict>
    <key>UIColorName</key>
    <string>LaunchBackground</string>
  </dict>
</dict>
</plist>
