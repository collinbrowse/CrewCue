// Server and Auth0 tenant, read by Info.plist. `/$()/` keeps xcconfig from reading `//` as a comment.
// Debug talks to the local API and the dev tenant.
CREWCUE_API_BASE_URL = http:/$()/127.0.0.1:3000
CREWCUE_AUTH0_DOMAIN = dev-ozh1r6603ymvszq6.us.auth0.com
CREWCUE_AUTH0_CLIENT_ID = oRRfHuZS7jN2pd8wn9aAwRnyay0kuzia
CREWCUE_AUTH0_AUDIENCE = https:/$()/api.crewcue.staging

// Release has no defaults. release.yml passes these as build settings; a Release build without
// them shows "CrewCue can't start" instead of calling localhost (LaunchConfiguration.swift).
CREWCUE_API_BASE_URL[config=Release] =
CREWCUE_AUTH0_DOMAIN[config=Release] =
CREWCUE_AUTH0_CLIENT_ID[config=Release] =
CREWCUE_AUTH0_AUDIENCE[config=Release] =

// RevenueCat public iOS SDK key (#649). Empty in Debug: purchases go through the fake purchaser
// and the local API's dev purchase route. release.yml passes CREWCUE_REVENUECAT_API_KEY; a Release
// build without it shows "Purchases aren't set up in this build." on the paywall.
CREWCUE_REVENUECAT_API_KEY =
CREWCUE_REVENUECAT_API_KEY[config=Release] =
// Sentry crash reporting (ADR 0010). Empty means off. release.yml passes the iOS project DSN
// to Release only; CrashReporting.swift never starts Sentry in Debug.
CREWCUE_SENTRY_DSN =

#include? "Secrets.xcconfig"
