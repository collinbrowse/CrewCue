# Copy this file to `apps/mobile/.env` and fill in staging values.
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time — do NOT put real secrets here.
# Setup guide: docs/runbooks/auth0-and-social-idp-setup.md

EXPO_PUBLIC_AUTH0_DOMAIN=dev-xxxxxxx.us.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=REPLACE_WITH_NATIVE_APP_CLIENT_ID
EXPO_PUBLIC_AUTH0_AUDIENCE=https://crewcue-staging-api
EXPO_PUBLIC_AUTH0_CONNECTION_GOOGLE=google-oauth2
EXPO_PUBLIC_AUTH0_CONNECTION_APPLE=apple
EXPO_PUBLIC_AUTH0_CONNECTION_EMAIL=Username-Password-Authentication
EXPO_PUBLIC_API_BASE_URL=https://your-api.up.railway.app
