# Local mobile profile — copied to apps/mobile/.env by `npm run env:local`
# Copy to apps/mobile/.env.local (or run `npm run env:init`) and fill Auth0 values.
# Keep Auth0 keys in sync with root `.env.local` (AUTH0_ISSUER / AUTH0_AUDIENCE).
# See docs/runbooks/auth0-and-social-idp-setup.md § Local API + Auth0 sync

EXPO_PUBLIC_AUTH0_DOMAIN=dev-xxxxxxx.us.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=REPLACE_WITH_NATIVE_APP_CLIENT_ID
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.crewcue.staging
EXPO_PUBLIC_AUTH0_CONNECTION_GOOGLE=google-oauth2
EXPO_PUBLIC_AUTH0_CONNECTION_APPLE=apple
EXPO_PUBLIC_AUTH0_CONNECTION_EMAIL=Username-Password-Authentication

# iOS Simulator → host loopback. Android emulator: http://10.0.2.2:4000
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:4000

EXPO_PUBLIC_MAPTILER_API_KEY=
EXPO_PUBLIC_STREAM_API_KEY=
