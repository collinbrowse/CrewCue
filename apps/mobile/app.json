{
  "expo": {
    "name": "CrewCue",
    "slug": "crewcue",
    "scheme": "crewcue",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crewcue.mobile",
      "usesAppleSignIn": true, 
      "deploymentTarget": "18.0"
    },
    "android": {
      "package": "com.crewcue.mobile"
    },
    "plugins": [
      "expo-dev-client",
      "@react-native-community/datetimepicker",
      "expo-localization",
      "expo-notifications",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CrewCue uses your location on the map to center on where you are when you tap the locate control.",
          "locationAlwaysAndWhenInUsePermission": "CrewCue may use your location in the background only if you enable features that require it.",
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CrewCue uses your photo library so you can attach images to crew chat messages.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/withChatPushDecryption.js"
    ]
  }
}
