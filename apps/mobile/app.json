{
  "expo": {
    "name": "CrewCue",
    "slug": "crewcue",
    "scheme": "crewcue",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crewcue.mobile"
    },
    "android": {
      "package": "com.crewcue.mobile"
    },
    "plugins": [
      "expo-dev-client",
      "expo-secure-store",
      "expo-web-browser"
    ]
  }
}
