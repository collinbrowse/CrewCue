# Staging-aligned API profile for local process when pointing tools at staging Auth0.
# Copied to repo-root `.env` by `npm run env:staging`.
# Deployed Railway staging still uses Railway dashboard vars — this file is for local CLI parity.

JWT_SECRET=replace-with-dev-secret
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Sentry error tracking (ADR 0010). Leave empty to keep it off; set on Railway only.
SENTRY_DSN=
PORT=4000
HOST=0.0.0.0
PERSISTENCE_MODE=postgres
DATABASE_URL=postgres://crewcue:crewcue@localhost:5432/crewcue

STREAM_API_KEY=
STREAM_API_SECRET=

# Crew chat push (ADR 0010) — see docs/runbooks/chat-push.md. Unset = log only.
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.crewcue.ios
FCM_SERVICE_ACCOUNT_JSON=
# Crew chat photos (Railway bucket). Unset locally = in-memory photos.
CHAT_PHOTO_BUCKET=
CHAT_PHOTO_ENDPOINT=
CHAT_PHOTO_ACCESS_KEY_ID=
CHAT_PHOTO_SECRET_ACCESS_KEY=

# Strava OAuth (W3-2) — server-only; see docs/runbooks/strava-oauth-setup.md
# Also set these on Railway staging. Never commit real secrets.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://crewcue-staging.up.railway.app/strava/oauth/redirect

AUTH0_ISSUER=https://dev-xxxxxxx.us.auth0.com/
AUTH0_AUDIENCE=https://api.crewcue.staging
