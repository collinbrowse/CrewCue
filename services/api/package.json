{
  "name": "@crewcue/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:memory": "PERSISTENCE_MODE=memory tsx watch src/server.ts",
    "dev:pg": "PERSISTENCE_MODE=postgres tsx watch src/server.ts",
    "build": "npm run build -w @crewcue/contracts && npm run build -w @crewcue/map-core && npm run build -w @crewcue/platform-client && rm -rf dist && tsc -p tsconfig.json",
    "start": "node dist/services/api/src/server.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/projection-backtest/tsconfig.json",
    "test": "npm run test:memory && npm run projection:backtest:check",
    "test:memory": "PERSISTENCE_MODE=memory sh -c 'npm run build -w @crewcue/contracts && npm run build -w @crewcue/map-core && npm run build -w @crewcue/platform-client && npm run build && node --test $(find dist/services/api/src -name \"*.test.js\" | sort)'",
    "test:pg": "PERSISTENCE_MODE=postgres sh -c 'npm run build -w @crewcue/contracts && npm run build -w @crewcue/map-core && npm run build -w @crewcue/platform-client && npm run build && node --test --test-concurrency=1 $(find dist/services/api/src -name \"*.test.js\" | sort)'",
    "test:pg:fresh": "./scripts/test-pg-fresh.sh",
    "db:migrate": "node ./scripts/apply-sql-migrations.mjs",
    "pacing:backtest": "tsx scripts/pacing-backtest.ts",
    "projection:backtest": "tsx scripts/projection-backtest/cli.ts",
    "projection:backtest:check": "tsx scripts/projection-backtest/cli.ts --fixture --check > /dev/null",
    "projection:backtest:make-fixture": "tsx scripts/projection-backtest/make-synthetic-fixture.ts",
    "pacing:eval": "tsx scripts/pacing-eval.ts",
    "pacing:eval:synth": "tsx scripts/pacing-eval-synth.ts",
    "pacing:eval:import": "tsx scripts/pacing-eval-import.ts",
    "finished-efforts:report": "tsx scripts/finished-efforts-report.ts",
    "course-history:import": "tsx scripts/course-history-import.ts",
    "course-history:link": "tsx scripts/course-history-link.ts"
  },
  "dependencies": {
    "@crewcue/contracts": "0.1.0",
    "@crewcue/map-core": "0.1.0",
    "@crewcue/platform-client": "0.1.0",
    "@fastify/jwt": "^10.2.6",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "stream-chat": "^9.54.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
