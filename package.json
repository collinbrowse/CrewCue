{
  "name": "crewcue",
  "private": true,
  "version": "0.1.0",
  "description": "CrewCue WS0 foundation monorepo",
  "main": "./apps/mobile/index.ts",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "db:migrate": "npm run db:migrate -w @crewcue/api",
    "verify:dual-client": "node scripts/verify-dual-client-architecture.mjs",
    "smoke:mobile:startup": "node scripts/mobile-startup-smoke.mjs",
    "build": "npm run build --workspaces --if-present",
    "smoke:mobile:android": "node scripts/mobile-android-deeplink-smoke.mjs",
    "smoke:mobile:ios": "node scripts/mobile-ios-deeplink-smoke.mjs",
    "test": "npm run test --workspaces --if-present",
    "test:memory": "npm run test:memory -w @crewcue/api",
    "test:pg": "npm run test:pg -w @crewcue/api",
    "test:pg:fresh": "npm run test:pg:fresh -w @crewcue/api",
    "lint": "npm run verify:dual-client && npm run lint --workspaces --if-present",
    "verify": "npm run build -w @crewcue/contracts && npm run build -w @crewcue/map-core && npm run lint && npm run typecheck && npm run test && npm run smoke:mobile:startup && npm run build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:api": "npm run dev -w @crewcue/api",
    "dev:api:memory": "npm run dev:memory -w @crewcue/api",
    "dev:api:pg": "npm run dev:pg -w @crewcue/api",
    "dev:mobile": "npm run dev -w @crewcue/mobile",
    "auth0:bootstrap-mobile-client": "node scripts/auth0/bootstrap-connection-config.mjs",
    "postinstall": "patch-package && npm run build -w @crewcue/contracts && npm run build -w @crewcue/map-core"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "expo": "~55.0.18",
    "expo-dev-client": "~55.0.32",
    "react": "19.2.0",
    "react-native": "0.83.6"
  },
  "devDependencies": {
    "patch-package": "^8.0.1"
  }
}
