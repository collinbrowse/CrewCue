{
  "name": "crewcue",
  "private": true,
  "version": "0.1.0",
  "description": "CrewCue WS0 foundation monorepo",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "db:migrate": "npm run db:migrate -w @crewcue/api",
    "verify:dual-client": "node scripts/verify-dual-client-architecture.mjs",
    "verify:client-behavior": "node scripts/verify-client-behavior.mjs",
    "verify:client-boundary": "node scripts/verify-client-boundary.mjs",
    "verify:client-codegen": "node scripts/generate-client-contracts.mjs",
    "verify:client-core": "node scripts/verify-client-core.mjs",
    "verify:client-core:android-build": "node scripts/verify-client-core-android-build.mjs",
    "verify:client-core:android": "node scripts/verify-client-core-android-build.mjs",
    "verify:client-pr-split": "node scripts/verify-client-pr-split.mjs",
    "verify:ios": "node scripts/verify-ios.mjs",
    "verify:android": "node scripts/verify-android.mjs",
    "build": "npm run build --workspaces --if-present",
    "agent:ios:ready": "node scripts/agent-ios-simulator-ready.mjs",
    "agent:android:ready": "node scripts/agent-android-emulator-ready.mjs",
    "agent:issue:ready": "node scripts/agent-issue-ready.mjs",
    "agent:pr:done": "node scripts/agent-pr-done.mjs",
    "agent:harness:test": "node --test scripts/agent-ready-parse.test.mjs scripts/pr-decision-doc-guard.test.mjs scripts/client-harness.test.mjs",
    "test": "npm run test --workspaces --if-present",
    "test:memory": "npm run test:memory -w @crewcue/api",
    "test:pg": "npm run test:pg -w @crewcue/api",
    "test:pg:fresh": "npm run test:pg:fresh -w @crewcue/api",
    "lint": "npm run verify:dual-client && npm run lint --workspaces --if-present",
    "verify:contracts": "npm run build -w @crewcue/contracts && npm run typecheck -w @crewcue/contracts && npm run test -w @crewcue/contracts",
    "verify:api": "npm run build -w @crewcue/contracts && npm run build -w @crewcue/map-core && npm run build -w @crewcue/platform-client && npm run typecheck -w @crewcue/api && npm run test -w @crewcue/api",
    "verify": "npm run build -w @crewcue/contracts && npm run build -w @crewcue/map-core && npm run build -w @crewcue/platform-client && npm run lint && npm run typecheck && npm run test && npm run build && npm run agent:harness:test && npm run verify:client-behavior && npm run verify:client-boundary && npm run verify:client-codegen && npm run verify:client-core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:api": "npm run dev -w @crewcue/api",
    "dev:api:memory": "npm run dev:memory -w @crewcue/api",
    "dev:api:pg": "npm run dev:pg -w @crewcue/api",
    "env:init": "node scripts/switch-dev-env.mjs init",
    "env:local": "node scripts/switch-dev-env.mjs local",
    "env:staging": "node scripts/switch-dev-env.mjs staging",
    "env:status": "node scripts/switch-dev-env.mjs status",
    "setup:macos-silicon": "bash scripts/setup-apple-silicon-toolchain.sh",
    "pod:ios": "node scripts/ios-pod-install.mjs",
    "auth0:bootstrap-mobile-client": "node scripts/auth0/bootstrap-connection-config.mjs",
    "postinstall": "patch-package && npm run build -w @crewcue/contracts && npm run build -w @crewcue/map-core && npm run build -w @crewcue/platform-client"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "patch-package": "^8.0.1"
  }
}
